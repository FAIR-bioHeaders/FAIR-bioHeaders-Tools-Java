<?xml version="1.0" encoding="UTF-8"?>
<!--
  fair-bioheaders-java: FAIR-bioHeaders header reader/validator for the JVM.

  This Source Code Form is subject to the terms of the Mozilla Public
  License, v. 2.0. If a copy of the MPL was not distributed with this
  file, You can obtain one at https://mozilla.org/MPL/2.0/.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.fairbioheaders</groupId>
  <artifactId>fair-bioheaders-java</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>FAIR-bioHeaders Tools (Java)</name>
  <description>Java library and CLI for reading, schema-validating and
    checksum-verifying FAIR-bioHeaders headers (FHR, FHP, FHGFF3).</description>
  <url>https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools-Java</url>

  <licenses>
    <license>
      <name>Mozilla Public License, Version 2.0</name>
      <url>https://www.mozilla.org/MPL/2.0/</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Version choices are documented in docs/DEPENDENCIES.md; the E0
         capability study (2026-11-14) proved draft/2020-12 support for the
         released contracts with json-schema-validator 3.0.9 on JDK 17. -->
    <version.json-schema-validator>3.0.9</version.json-schema-validator>
    <version.snakeyaml>2.7</version.snakeyaml>
    <version.junit>5.11.4</version.junit>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${version.json-schema-validator}</version>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${version.snakeyaml}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${version.junit}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Ship the license inside the jar next to the code and bundled
           schemas it covers (the Maven Central metadata lesson from the
           family: state the license in every place it is emitted). -->
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.fairbioheaders.cli.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
